{
	"compilerOptions": {
		"target": "ES2018",
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2018"],
		"strict": true,
		"noImplicitAny": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/**/*.ts",
		"tests/**/*.tsx",
		"scripts/**/*.ts",
		"vitest.config.ts"
	],
	"exclude": ["prototype", "node_modules", "dist", "coverage", "main.js"]
}
