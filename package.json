{
	"name": "tablify",
	"version": "0.1.0",
	"description": "A spreadsheet-grade grid view for Obsidian Bases.",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"brand:gate": "bun scripts/brand-gate.ts",
		"manifest:check": "bun scripts/manifest-check.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:layout": "playwright test",
		"test:watch": "vitest",
		"size": "bun scripts/bundle-size.ts",
		"contrast": "bun scripts/contrast.ts",
		"css:gate": "bun scripts/css-gate.ts",
		"check": "bun run typecheck && bun run lint && bun run brand:gate && bun run manifest:check && bun run format:check && bun run test && bun run build && bun run contrast && bun run css:gate && bun run size"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/node": "20.19.43",
		"@vitest/coverage-v8": "3.2.7",
		"esbuild": "0.25.5",
		"eslint": "9.39.4",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"jsdom": "29.1.1",
		"obsidian": "1.13.1",
		"prettier": "3.9.9",
		"typescript": "5.8.3",
		"typescript-eslint": "8.59.1",
		"vitest": "3.2.7"
	},
	"dependencies": {}
}
